# Top Token backend: environment template
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored. NEVER commit a real secret.
#
# In staging and production these are set through the Render dashboard, not a
# file. The application validates them at startup and refuses to boot if a
# required value is missing or unsafe.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required in staging and production. Optional in Phase A, which has no database
# yet; from Phase B onward local development needs it too.
# Local development uses an embedded PostgreSQL started by `npm run db:up`.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/toptoken_dev

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Required in staging and production, minimum 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Must be true in staging and production.
COOKIE_SECURE=false
# lax | strict | none   ("none" requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
# Leave blank for host-only cookies.
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated exact origins. "*" is rejected: the storefront sends
# credentials, and a wildcard with credentials is both invalid and unsafe.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4321

# ---------------------------------------------------------------------------
# Authentication (email one-time code)
# ---------------------------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# LOCAL DEVELOPMENT ONLY. Returns the sign-in code in the API response so you
# can authenticate without a mail provider. The application REFUSES TO START if
# this is true while NODE_ENV is staging or production.
OTP_DEV_ECHO=true

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# sandbox only. PAYMENT_MODE=production is rejected at startup because no
# payment provider is integrated yet; nobody should be able to flip a flag and
# believe real money is moving.
PAYMENT_MODE=sandbox

# Verifies the signature on every provider webhook. Required in staging and
# production, minimum 32 characters, and never the same value as SESSION_SECRET.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# log  = writes the message to the application log and sends nothing.
#        Development only; startup is refused if this is used once deployed,
#        because a customer whose code was never emailed has not been served.
# none = send nothing and say nothing.
# A real transport arrives when a mail provider is configured.
NOTIFICATION_TRANSPORT=log

# ---------------------------------------------------------------------------
# Operators (admin API)
# ---------------------------------------------------------------------------
# Who may work the fulfillment queue: a comma-separated list of `name:token`.
#
# Named, one per person, and never shared. Every operator action is written to
# the audit log with this name, and "an operator marked it delivered" answers
# nothing when a customer disputes an order.
#
# Required in staging and production; without it nobody can deliver an order.
# Absent locally, the admin API refuses every request. There is deliberately no
# default token, because a default that works is a default that ships.
#
# Generate one per person:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ADMIN_TOKENS=yuval:<32+ random chars>,dekel:<a different 32+ random chars>
ADMIN_TOKENS=

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------
# How often the server releases expired inventory holds, expires abandoned
# payments and prunes old idempotency keys. Safe to run on every instance: each
# step claims rows atomically, so instances divide the work rather than repeat
# it. Set to 0 to disable, which tests do so a sweep cannot fire mid-assertion.
HOUSEKEEPING_INTERVAL_SECONDS=60

# Left blank deliberately. A real provider key is added only after a merchant
# account exists and the commercial and legal gate in docs/COMPLIANCE.md passes.
PAYMENT_API_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug
REQUEST_BODY_LIMIT=100kb
